# Environment Configuration Example
# Copy to .env and adjust values as needed. Do not commit sensitive keys or secrets.

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000

# CORS Allowed Origins (comma-separated, or * for development)
CORS_ORIGINS=*

# Model & Storage Settings
MODELS_DIR=models
MAX_TEXT_LENGTH=10000
MAX_BATCH_SIZE=100

# Browser Extension Configuration
# For Chrome/Edge Extension, configure API_BASE_URL in extension/popup.js:
# const API_BASE_URL = "http://127.0.0.1:8000";
